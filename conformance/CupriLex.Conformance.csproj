<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CupriLex.Conformance</RootNamespace>
    <AssemblyName>CupriLex.Conformance</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CupriFaceVersion)' == ''">
    <CupriFaceVersion>0.28.1</CupriFaceVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NOT centrally managed. This project exists to be pointed at different engine versions, so
      the version is an argument rather than a fact about the repository:

          dotnet build conformance -p:CupriFaceVersion=0.27.0

      SkiaSharp is pinned to the engine's own, because SKImage crosses the boundary.
    -->
    <PackageReference Include="CupriFace" Version="$(CupriFaceVersion)" />
    <!-- Optional, and 32% of the corpus needs it: inline <svg> draws only when a
         document calls UseSvg(). Pinned to the engine, which is what defines it. -->
    <PackageReference Include="CupriFace.Svg" Version="$(CupriFaceVersion)" />
    <!-- Also optional, and the corpus ships every one of its faces as .woff2: without
         this the engine refuses them by name and all 157 blocks that bring a typeface
         render in a substitute. -->
    <PackageReference Include="CupriFace.Woff2" Version="$(CupriFaceVersion)" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

</Project>
