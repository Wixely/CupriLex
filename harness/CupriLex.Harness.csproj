<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CupriLex.Harness</RootNamespace>
    <AssemblyName>CupriLex.Harness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CupriFaceVersion)' == ''">
    <CupriFaceVersion>0.28.1</CupriFaceVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Version as an argument, for the same reason conformance/ does it: a score is only meaningful
      beside the engine version that produced it.

          dotnet build harness -p:CupriFaceVersion=0.27.0

      SkiaSharp is pinned to the engine's own, because SKImage crosses the boundary. It is also
      what decodes the browser's PNGs, so both sides of every comparison are decoded by one codec.
    -->
    <PackageReference Include="CupriFace" Version="$(CupriFaceVersion)" />
    <!-- Optional, and 32% of the corpus needs it: inline <svg> draws only when a
         document calls UseSvg(). Pinned to the engine, which is what defines it. -->
    <PackageReference Include="CupriFace.Svg" Version="$(CupriFaceVersion)" />
    <!-- Also optional, and the corpus ships every one of its faces as .woff2: without
         this the engine refuses them by name and all 157 blocks that bring a typeface
         render in a substitute. -->
    <PackageReference Include="CupriFace.Woff2" Version="$(CupriFaceVersion)" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\compiler\CupriLex.Compiler.csproj" />
  </ItemGroup>

</Project>
