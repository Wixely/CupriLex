{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build harness",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/harness/CupriLex.Harness.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build cli",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/cli/CupriLex.Cli.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build conformance",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/conformance/CupriLex.Conformance.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build tests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/tests/CupriLex.Harness.Tests/CupriLex.Harness.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "open review gallery",
      "detail": "Open review/index.html in the default browser",
      "type": "shell",
      "command": "start",
      "args": [
        "",
        "review\\index.html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/c",
          "start",
          "",
          "review\\index.html"
        ]
      },
      "linux": {
        "command": "xdg-open",
        "args": [
          "review/index.html"
        ]
      },
      "osx": {
        "command": "open",
        "args": [
          "review/index.html"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }
  ]
}
